# Zkopírujte na .env (cp .env.example .env), doplňte hodnoty a spusťte: docker compose up -d
# Soubor .env nikdy necommitujte (obsahuje tajné hodnoty). Úplný seznam proměnných aplikace: docs/deployment.md

# --- Cloudflare Tunnel (povinné): token z Zero Trust > Networks > Tunnels > váš tunel
TUNNEL_TOKEN=

# --- Aplikace: režim veřejné instance (anonymní relace + limity)
PIDTOOLS_AUTH=public
# Aplikace je za Cloudflare: IP návštěvníka se bere z hlavičky CF-Connecting-IP (pro limity na IP)
PIDTOOLS_TRUST_CF_IP=1
PIDTOOLS_LOG_LEVEL=INFO

# --- Limity (volitelné; výchozí hodnoty a další proměnné veřejného režimu: docs/deployment.md)
#PIDTOOLS_MAX_WORKSPACES=50
#PIDTOOLS_MAX_WORKSPACES_USER=2
#PIDTOOLS_MAX_JOBS=3
#PIDTOOLS_MAX_JOBS_USER=1
#PIDTOOLS_MAX_UPLOAD_MB=20
#PIDTOOLS_WORKSPACE_TTL=1800

# --- Prostředky kontejneru app (VM.Standard.A1.Flex: až 4 OCPU / 24 GB zdarma; výchozí níže)
#APP_MEM_LIMIT=6g
#APP_CPUS=3
#APP_PIDS_LIMIT=512

# --- Obraz a automatické aktualizace
# Návrat na konkrétní verzi: PIDTOOLS_IMAGE=ghcr.io/javor55/pid-tools:sha-abc1234
#PIDTOOLS_IMAGE=ghcr.io/javor55/pid-tools:deploy
#WATCHTOWER_INTERVAL=300

# --- Soukromý balíček GHCR (u veřejného nechte prázdné): uživatel GitHub a PAT s právem read:packages
#GHCR_USER=
#GHCR_TOKEN=
