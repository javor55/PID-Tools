# Zkopírujte na .env (cp .env.example .env), doplňte hodnoty a spusťte: docker compose up -d
# Soubor .env nikdy necommitujte (obsahuje tajné hodnoty). Úplný seznam proměnných aplikace: docs/deployment.md

# --- Cloudflare Tunnel (povinné): token z Zero Trust > Networks > Tunnels > váš tunel
TUNNEL_TOKEN=

# --- Aplikace: režim veřejné instance (anonymní relace + limity)
PIDTOOLS_AUTH=public
# Aplikace je za Cloudflare: IP návštěvníka se bere z hlavičky CF-Connecting-IP (pro limity na IP). Bezpečné jen proto,
# že kontejner app nepublikuje žádný port (dosáhne na něj jen cloudflared) – v compose.yml porty nepřidávejte.
PIDTOOLS_TRUST_CF_IP=1
PIDTOOLS_LOG_LEVEL=INFO

# --- Limity veřejného režimu (zakomentované = výchozí hodnota uvedená vpravo; popis: docs/deployment.md, „Public mode“)
#PIDTOOLS_SESSION_TTL=7200          # nečinná relace návštěvníka se po N s zahodí (i s daty)
#PIDTOOLS_MAX_SESSIONS=200          # nejvýše souběžných relací
#PIDTOOLS_MAX_UPLOAD_MB=20          # největší nahraný soubor / projekt
#PIDTOOLS_MAX_WORKSPACES_USER=3     # pracovních prostorů na relaci
#PIDTOOLS_MAX_WORKSPACES=100        # pracovních prostorů celkem
#PIDTOOLS_MAX_JOBS_USER=2           # úloh (identifikace, optimalizace…) na relaci
#PIDTOOLS_MAX_JOBS=4                # souběžných výpočtů celkem (výchozí = počet CPU kontejneru)
#PIDTOOLS_MAX_QUEUE=4               # úloh čekajících ve frontě celkem
#PIDTOOLS_RATE_LIMIT=300            # požadavků za minutu na IP
#PIDTOOLS_RATE_UPLOAD=10            # nahrání / spuštění úloh za minutu na IP
#PIDTOOLS_WORKSPACE_TTL=3600        # nečinný pracovní prostor se po N s uvolní
#PIDTOOLS_COOKIE_SECURE=1           # cookie relace jen přes HTTPS (za tunelem vždy 1)

# --- Prostředky kontejneru app (VM.Standard.A1.Flex: až 4 OCPU / 24 GB zdarma; výchozí níže)
#APP_MEM_LIMIT=6g
#APP_CPUS=3
#APP_PIDS_LIMIT=512

# --- Obraz (automatické aktualizace zajišťuje časovač z install-update-timer.sh)
# Návrat na konkrétní verzi: PIDTOOLS_IMAGE=ghcr.io/javor55/pid-tools:sha-abc1234
#PIDTOOLS_IMAGE=ghcr.io/javor55/pid-tools:deploy
# Soukromý balíček GHCR: jednou na VM `docker login ghcr.io` s PAT (právo read:packages) – viz README, bod 3.3
